<% layout("/layouts/boilerplate") %>
<div class="row mt-3 mb-5">
    <div class="col-lg-8 offset-lg-2">
        <h3 class="mb-4 fw-bold">My Bookings</h3>

        <!-- Section 1: Bookings Made by Current User -->
        <h5 class="fw-semibold text-muted mb-3"><i class="fa-solid fa-suitcase-rolling me-2 text-danger"></i>My Trips</h5>
        <% if (!bookings || bookings.length === 0) { %>
            <div class="alert alert-secondary text-center p-4 mb-4">
                <h6>You have no booking requests yet.</h6>
                <p class="text-muted small mb-2">Start exploring places to stay around the world!</p>
                <a href="/listings" class="btn btn-sm btn-danger mt-1">Explore Listings</a>
            </div>
        <% } else { %>
            <div class="row mb-4">
                <% for (let booking of bookings) { %>
                    <div class="col-12 mb-3">
                        <div class="card shadow-sm border">
                            <div class="row g-0 align-items-center">
                                <div class="col-md-4">
                                    <% if (booking.listing && booking.listing.image && booking.listing.image.url) { %>
                                        <img src="<%= booking.listing.image.url %>" class="img-fluid rounded-start" alt="<%= booking.listing.title %>" style="height: 190px; width: 100%; object-fit: cover;">
                                    <% } else { %>
                                        <div class="bg-light text-center py-5">No Image</div>
                                    <% } %>
                                </div>
                                <div class="col-md-8">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <h5 class="card-title mb-1">
                                                <% if (booking.listing) { %>
                                                    <a href="/listings/<%= booking.listing._id %>" class="text-decoration-none text-dark fw-bold">
                                                        <%= booking.listing.title %>
                                                    </a>
                                                <% } else { %>
                                                    Listing no longer available
                                                <% } %>
                                            </h5>
                                            <!-- Booking Status Badge -->
                                            <% if (booking.status === "Accepted") { %>
                                                <span class="badge bg-success"><i class="fa-solid fa-circle-check me-1"></i>Accepted</span>
                                            <% } else if (booking.status === "Declined") { %>
                                                <span class="badge bg-danger"><i class="fa-solid fa-circle-xmark me-1"></i>Declined</span>
                                            <% } else { %>
                                                <span class="badge bg-warning text-dark"><i class="fa-regular fa-clock me-1"></i>Pending</span>
                                            <% } %>
                                        </div>

                                        <% if (booking.listing) { %>
                                            <p class="card-text text-muted mb-1 small">
                                                <i class="fa-solid fa-location-dot"></i> <%= booking.listing.location %>, <%= booking.listing.country %>
                                            </p>
                                        <% } %>
                                        <p class="card-text mb-1">
                                            <b>Dates:</b> <%= new Date(booking.checkIn).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) %> &rarr; <%= new Date(booking.checkOut).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) %>
                                        </p>
                                        <p class="card-text mb-2">
                                            <b>Total Price:</b> &#8377; <%= booking.totalPrice ? booking.totalPrice.toLocaleString("en-IN") : "0" %>
                                            <small class="text-muted">(Pay offline at property)</small>
                                        </p>
                                        <form method="POST" action="/bookings/<%= booking._id %>?_method=DELETE" class="d-inline" onsubmit="return confirm('Are you sure you want to cancel this booking?');">
                                            <button class="btn btn-sm btn-outline-danger">Cancel Booking</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } %>

        <!-- Section 2: Received Booking Requests for Listings Owned by Current User -->
        <% if (receivedBookings && receivedBookings.length > 0) { %>
            <hr class="my-4">
            <h5 class="fw-semibold text-muted mb-3"><i class="fa-solid fa-bell-concierge me-2 text-danger"></i>Booking Requests for Your Listings</h5>
            <div class="row">
                <% for (let reqBooking of receivedBookings) { %>
                    <div class="col-12 mb-3">
                        <div class="card shadow-sm border p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h6 class="fw-bold mb-0">
                                        <% if (reqBooking.listing) { %>
                                            <%= reqBooking.listing.title %>
                                        <% } else { %>
                                            Property
                                        <% } %>
                                    </h6>
                                    <small class="text-muted">
                                        Requested by: <b>@<%= reqBooking.user ? reqBooking.user.username : "Guest" %></b> (<%= reqBooking.user ? reqBooking.user.email : "" %>)
                                    </small>
                                </div>
                                <div>
                                    <% if (reqBooking.status === "Accepted") { %>
                                        <span class="badge bg-success"><i class="fa-solid fa-circle-check me-1"></i>Accepted</span>
                                    <% } else if (reqBooking.status === "Declined") { %>
                                        <span class="badge bg-danger"><i class="fa-solid fa-circle-xmark me-1"></i>Declined</span>
                                    <% } else { %>
                                        <span class="badge bg-warning text-dark"><i class="fa-regular fa-clock me-1"></i>Pending</span>
                                    <% } %>
                                </div>
                            </div>
                            <p class="card-text mb-1">
                                <b>Requested Dates:</b> <%= new Date(reqBooking.checkIn).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) %> &rarr; <%= new Date(reqBooking.checkOut).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) %>
                            </p>
                            <p class="card-text mb-3">
                                <b>Total Amount:</b> &#8377; <%= reqBooking.totalPrice ? reqBooking.totalPrice.toLocaleString("en-IN") : "0" %>
                            </p>
                            <% if (reqBooking.status === "Pending") { %>
                                <div class="d-flex gap-2">
                                    <form method="POST" action="/bookings/<%= reqBooking._id %>/status" class="d-inline">
                                        <input type="hidden" name="status" value="Accepted">
                                        <button class="btn btn-sm btn-success px-3">
                                            <i class="fa-solid fa-check me-1"></i>Accept
                                        </button>
                                    </form>
                                    <form method="POST" action="/bookings/<%= reqBooking._id %>/status" class="d-inline">
                                        <input type="hidden" name="status" value="Declined">
                                        <button class="btn btn-sm btn-outline-danger px-3">
                                            <i class="fa-solid fa-xmark me-1"></i>Decline
                                        </button>
                                    </form>
                                </div>
                            <% } %>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } %>
    </div>
</div>
